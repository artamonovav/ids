{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IDS",
  "version": "0.1.0",
  "identifier": "ru.nota.ids.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "beforeDevCommand": "bun run dev"
  },
  "app": {
    "windows": [
      { "title": "IDS — Issue Documentation System", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
